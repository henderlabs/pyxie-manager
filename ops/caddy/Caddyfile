# PyXie Manager edge proxy.
#
#   PYXIE_HOSTNAME  FQDN to serve (e.g. cre-pyxie.slc.crengland.com)
#   PYXIE_TLS_MODE  internal | file | acme   -> imports tls/<mode>.caddy
#
# Switching certificate source is one .env change plus `docker compose up -d
# pyxie-manager-caddy`; nothing in this file changes. HTTP (80) redirects to
# HTTPS automatically for the named host.

{$PYXIE_HOSTNAME} {
	import tls/{$PYXIE_TLS_MODE}.caddy

	encode zstd gzip

	# Caddy sets X-Forwarded-For/Proto/Host on the upstream request.
	# Embedded VM console: websocket straight to the API (the Next.js layer cannot
	# proxy websockets). The one-time ticket in this path is useless after first use
	# and no access log is configured, so it is not written anywhere.
	handle /console-ws/* {
		reverse_proxy pyxie-manager-api:8000
	}

	handle {
		reverse_proxy pyxie-manager-web:3000
	}

	# HSTS is deliberately NOT enabled yet: with a self-signed cert it would
	# lock browsers out of click-through. Enable once the real cert is live.
}
