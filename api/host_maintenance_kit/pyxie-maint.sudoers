# /etc/sudoers.d/pyxie-maint
#
# Grants the dedicated 'pyxie-hostmaint' identity NOPASSWD sudo to run
# /usr/local/sbin/pyxie-maint with ONLY these six exact argument forms --
# nothing else. Do not add a wildcard (e.g. "pyxie-maint *") to this file;
# that would defeat the entire point of a restricted wrapper.
#
# Install with mode 0440, owned by root:root, and always validate with
# `visudo -cf` before trusting it -- a malformed sudoers.d file can lock
# out sudo entirely on some configurations.

pyxie-hostmaint ALL=(root) NOPASSWD: /usr/local/sbin/pyxie-maint version, /usr/local/sbin/pyxie-maint status, /usr/local/sbin/pyxie-maint refresh, /usr/local/sbin/pyxie-maint plan, /usr/local/sbin/pyxie-maint apply, /usr/local/sbin/pyxie-maint verify

# No PTY is available over a non-interactive SSH exec_command session --
# without this, sudo refuses to run at all on distros with `requiretty` set.
Defaults:pyxie-hostmaint !requiretty
