#!/bin/bash
# /usr/local/sbin/pyxie-maint-ssh-dispatch
#
# Forced command for the pyxie-hostmaint SSH key (via authorized_keys
# `command=`), running as pyxie-hostmaint itself -- NOT root. This is an
# extra layer in front of sudo/pyxie-maint, not a replacement for it: even
# if the SSH private key leaked, the attacker could not get an interactive
# shell or run anything other than these six exact invocations, full stop,
# before sudo (and its own separate restriction) is ever reached.
#
# $SSH_ORIGINAL_COMMAND is matched against an exact-string allowlist --
# never evaluated, never passed to eval/sh -c, never used to build another
# command. Anything that doesn't match exactly is refused.

set -euo pipefail

case "${SSH_ORIGINAL_COMMAND:-}" in
  "sudo /usr/local/sbin/pyxie-maint version") exec sudo /usr/local/sbin/pyxie-maint version ;;
  "sudo /usr/local/sbin/pyxie-maint status")  exec sudo /usr/local/sbin/pyxie-maint status ;;
  "sudo /usr/local/sbin/pyxie-maint refresh") exec sudo /usr/local/sbin/pyxie-maint refresh ;;
  "sudo /usr/local/sbin/pyxie-maint plan")    exec sudo /usr/local/sbin/pyxie-maint plan ;;
  "sudo /usr/local/sbin/pyxie-maint apply")   exec sudo /usr/local/sbin/pyxie-maint apply ;;
  "sudo /usr/local/sbin/pyxie-maint verify")  exec sudo /usr/local/sbin/pyxie-maint verify ;;
  *)
    echo '{"error":"command not permitted for this identity"}' >&2
    exit 3
    ;;
esac
