# Copy to .env and fill in real values. Never commit .env with real secrets
# (this repo is private, but keep the same discipline for backups).

POSTGRES_DB=pyxie_manager
POSTGRES_USER=pyxie_manager
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+psycopg2://pyxie_manager:changeme@pyxie-manager-db:5432/pyxie_manager
REDIS_URL=redis://pyxie-manager-redis:6379/0

# Fernet key used to encrypt PVE credential secrets at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PYXIE_CREDENTIAL_KEY=

# The write-capability kill switch used to live here (PVE_MUTATIONS_ENABLED)
# -- it's now a Settings-page toggle ("Allow PyXie to write to Proxmox VE"
# under Platform > Settings), backed by the database, not an env var, so it
# can be changed live without a redeploy. See README.md "Safety Contract
# for every PVE write".

# App version is NOT set here -- it's read from the git-tracked VERSION file
# at the repo root (single source of truth, mirrored by a git tag on every
# release). See "Versioning" in README.md.
TZ=America/Denver
