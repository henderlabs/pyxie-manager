# Copy to .env and fill in real values. Never commit .env with real secrets
# (this project uses no git at all, but keep the same discipline for backups).

POSTGRES_DB=pyxie_manager
POSTGRES_USER=pyxie_manager
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql+psycopg2://pyxie_manager:changeme@pyxie-manager-db:5432/pyxie_manager
REDIS_URL=redis://pyxie-manager-redis:6379/0

# Fernet key used to encrypt PVE credential secrets at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PYXIE_CREDENTIAL_KEY=

# Global kill switch for the write-capability engine (Stage W0+). Keep this
# false until you have deliberately decided to allow PyXie to submit writes
# to PVE -- every write path re-checks this value at call time, not just at
# startup. Approving an individual operation in the UI is a SEPARATE gate;
# both must be true for any PVE mutation to actually happen.
PVE_MUTATIONS_ENABLED=false

APP_VERSION=0.1.0-w0
TZ=America/Denver
