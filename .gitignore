# Environment / secrets — never commit real values
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo

# OS / editor
.DS_Store
.vscode/
.idea/

# Local backups / dumps
*.bak
*.dump
*.sql.gz

# TLS material for PYXIE_TLS_MODE=file
certs/*
!certs/.gitkeep
